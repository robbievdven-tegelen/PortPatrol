<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>PortPatrol</AssemblyName>
    <RootNamespace>PortPatrol</RootNamespace>
    <Product>PortPatrol</Product>
    <Company>Imagination</Company>
    <Copyright>Copyright (c) 2026 Imagination</Copyright>
    <Version>0.9.0</Version>
    <ApplicationIcon>Assets\portpatrol.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\icon.png" />
    <Resource Include="Assets\portpatrol.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
